# Gabarit des variables d'environnement — copier vers .env et renseigner les vraies valeurs.
# Ne JAMAIS committer .env. Voir README.md pour le détail de chaque clé.
# La clé API Claude n'a pas sa place dans ce fichier (gérée séparément, hors dépôt).

# --- Paiement (facturation des abonnements) ---
ORANGE_MONEY_API_KEY=
MTN_MOMO_API_KEY=
WAVE_API_KEY=

# --- Réseaux sociaux ---
META_ADS_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_BUSINESS_TOKEN=
GOOGLE_ADS_TOKEN=
GOOGLE_BUSINESS_PROFILE_TOKEN=

# --- Base de données ---
DATABASE_URL=

# --- Maintenance ---
SENTRY_DSN=
UPTIME_MONITOR_TOKEN=
BACKUP_STORAGE_KEY=

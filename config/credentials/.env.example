# Gabarit des variables d'environnement — copier vers .env et renseigner les vraies valeurs.
# Ne JAMAIS committer .env. Voir README.md pour le détail de chaque clé.
# La clé API Claude n'a pas sa place dans ce fichier (gérée séparément, hors dépôt).

# --- Paiement (facturation des abonnements) ---
# Actifs au Gabon (pays de lancement) :
ORANGE_MONEY_API_KEY=
AIRTEL_MONEY_API_KEY=
MOOV_MONEY_API_KEY=
# Réservés pour l'extension vers d'autres pays (non actifs au Gabon) :
MTN_MOMO_API_KEY=
WAVE_API_KEY=

# --- Réseaux sociaux ---
META_ADS_TOKEN=
# META_APP_ID/META_APP_SECRET : utilisés dès aujourd'hui par l'agent Prospection (recherche
# de Pages Meta, voir section Prospection ci-dessous) — pas encore par l'agent Réseaux
# sociaux, qui publie via Client.meta_page_access_token (par client, en base), pas ces
# identifiants d'app au niveau plateforme. Serviraient aussi à un futur flux OAuth de
# connexion Meta côté Réseaux sociaux (non implémenté).
META_APP_ID=
META_APP_SECRET=
WHATSAPP_BUSINESS_TOKEN=
GOOGLE_ADS_TOKEN=
GOOGLE_BUSINESS_PROFILE_TOKEN=

# --- Prospection ---
# Distincte de GOOGLE_BUSINESS_PROFILE_TOKEN (fiche établissement du client lui-même) : sert
# à rechercher D'AUTRES établissements pour la prospection.
GOOGLE_PLACES_API_KEY=
# Recherche de Pages professionnelles Meta (deuxième source, en plus de Google Places) —
# réutilise META_APP_ID/META_APP_SECRET ci-dessus. Vide = recherche limitée à Google Places,
# sans erreur (voir agents/prospection/sources/meta_pages.py).

# --- Base de données ---
DATABASE_URL=

# --- Maintenance ---
SENTRY_DSN=
UPTIME_MONITOR_TOKEN=
# Jeton interne staff (stopgap, pas un vrai système d'auth — voir platform_core/config.py)
OPS_API_TOKEN=
# Secret partagé pour vérifier la signature HMAC des webhooks Sentry entrants (en-tête
# Sentry-Hook-Signature). Généré/renseigné côté Sentry (paramètres du client webhook).
SENTRY_WEBHOOK_SECRET=

# --- Sécurité (chiffrement au repos) ---
# Clé Fernet (générer avec `python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"`) — chiffre Client.meta_page_access_token et
# Client.whatsapp_access_token en base (voir platform_core/encryption.py). Vide en local =
# stockage en clair (dégradation explicite, jamais acceptable en production).
TOKEN_ENCRYPTION_KEY=

# --- Planning (rappels de RDV) ---
# Compte WhatsApp Business de la PLATEFORME elle-même (l'équipe qui opère la plateforme),
# distinct du compte WhatsApp de chaque client ci-dessus (Réseaux sociaux/Prospection) : ici
# c'est le staff qui contacte le client pour lui rappeler un rendez-vous, jamais l'inverse.
# Vide = la tâche planifiée de rappel ne fait rien (voir agents/planning/scheduled_jobs.py).
PLATFORM_WHATSAPP_PHONE_NUMBER_ID=
PLATFORM_WHATSAPP_ACCESS_TOKEN=

# --- Infrastructure (Fly.io, Cloudflare R2) ---
FLY_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

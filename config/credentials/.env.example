# Gabarit des variables d'environnement — copier vers .env et renseigner les vraies valeurs.
# Ne JAMAIS committer .env. Voir README.md pour le détail de chaque clé.
# La clé API Claude n'a pas sa place dans ce fichier (gérée séparément, hors dépôt).

# --- Paiement (facturation des abonnements) ---
# Actifs au Gabon (pays de lancement) :
ORANGE_MONEY_API_KEY=
AIRTEL_MONEY_API_KEY=
MOOV_MONEY_API_KEY=
# Réservés pour l'extension vers d'autres pays (non actifs au Gabon) :
MTN_MOMO_API_KEY=
WAVE_API_KEY=

# --- Réseaux sociaux ---
META_ADS_TOKEN=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_BUSINESS_TOKEN=
GOOGLE_ADS_TOKEN=
GOOGLE_BUSINESS_PROFILE_TOKEN=

# --- Base de données ---
DATABASE_URL=

# --- Maintenance ---
SENTRY_DSN=
UPTIME_MONITOR_TOKEN=
# Jeton interne staff (stopgap, pas un vrai système d'auth — voir platform_core/config.py)
OPS_API_TOKEN=

# --- Infrastructure (Fly.io, Cloudflare R2) ---
FLY_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

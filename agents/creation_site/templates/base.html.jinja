<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ brief.business_name }}</title>
  <!-- Tailwind via CDN : placeholder de scaffolding, à remplacer par un build compilé
       avant toute mise en production réelle (comme app/templates/base.html). -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-gray-900">
  <header class="border-b">
    <div class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between">
      <span class="text-xl font-semibold">{{ brief.business_name }}</span>
      <nav class="space-x-4 text-sm">
        <a href="#about">À propos</a>
        <a href="#items">{% block nav_items_label %}Services{% endblock %}</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <section class="bg-gray-50 py-20 text-center px-4">
    <h1 class="text-3xl md:text-4xl font-bold">{{ content.hero_tagline }}</h1>
    <p class="mt-4 text-lg text-gray-600">{{ content.hero_subtitle }}</p>
  </section>

  <section id="about" class="max-w-3xl mx-auto py-16 px-4">
    <h2 class="text-2xl font-semibold mb-4">À propos</h2>
    <p class="text-gray-700">{{ content.about_text }}</p>
  </section>

  <section id="items" class="max-w-5xl mx-auto py-16 px-4">
    <h2 class="text-2xl font-semibold mb-8">{% block items_title %}Nos services{% endblock %}</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {% for item in content.items %}
      <div class="border rounded-lg p-6">
        <h3 class="font-semibold">{{ item.title }}</h3>
        <p class="mt-2 text-gray-600">{{ item.description }}</p>
      </div>
      {% endfor %}
    </div>
  </section>

  <section id="contact" class="bg-gray-50 py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-semibold mb-4">Contact</h2>
      <p class="text-gray-700 mb-6">{{ content.contact_intro }}</p>
      <p class="font-medium">{{ brief.phone }}</p>
      {% if brief.whatsapp %}
      <a href="https://wa.me/{{ brief.whatsapp }}" class="inline-block mt-4 bg-green-600 text-white px-6 py-3 rounded-lg">
        Contacter sur WhatsApp
      </a>
      {% endif %}
      {% if brief.address %}<p class="mt-4 text-gray-600">{{ brief.address }}</p>{% endif %}
    </div>
  </section>

  <footer class="py-6 text-center text-sm text-gray-500 border-t">
    &copy; {{ brief.business_name }}
  </footer>
</body>
</html>
